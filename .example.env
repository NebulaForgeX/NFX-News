# NFX-News Docker Compose Environment Variables
# 项目配置 / Project Configuration

# ============================================
# NFX-Edge 路由 Host（本栈不跑 Traefik）
# Traefik routing hosts — NFX-Edge is the only reverse proxy
# ============================================
TRAEFIK_API_HOST=news-api.example.com
TRAEFIK_CONSOLE_HOST=news.example.com

# ============================================
# 服务端口配置 / Service Ports Configuration
# ============================================
HTTP_PORT=8080
CONSOLE_PORT=80
CONSOLE_EXTERNAL_PORT=10190
VITE_PORT=5174
VITE_API_URL=https://news-api.example.com
VITE_IDENTITY_API_URL=https://api.example.com

# ============================================
# gRPC 端口配置 / gRPC Ports Configuration
# ============================================
# Identity auth gRPC (NFX-Identity auth module, not a local News auth service)
GRPC_PORT_AUTH=10156
GRPC_PORT_SOURCE=10171
GRPC_PORT_NEWS=10172
GRPC_PORT_CRAWL=10173
GRPC_PORT_REPORT=10174
GRPC_PORT_NOTIFY=10175
GRPC_PORT_MCP=10176
GRPC_PORT_SYSTEM=10177

# ============================================
# gRPC 服务主机配置 / gRPC Service Host Configuration
# ============================================
GRPC_HOST_AUTH=192.168.1.64
GRPC_HOST_SOURCE=192.168.1.64
GRPC_HOST_NEWS=192.168.1.64
GRPC_HOST_CRAWL=192.168.1.64
GRPC_HOST_REPORT=192.168.1.64
GRPC_HOST_NOTIFY=192.168.1.64
GRPC_HOST_MCP=192.168.1.64
GRPC_HOST_SYSTEM=192.168.1.64

# ============================================
# API 路径前缀 / API Path Prefixes
# ============================================
API_PREFIX_PATH_SOURCE=/source
API_PREFIX_PATH_NEWS=/news
API_PREFIX_PATH_CRAWL=/crawl
API_PREFIX_PATH_REPORT=/report
API_PREFIX_PATH_NOTIFY=/notify
API_PREFIX_PATH_MCP=/mcp
API_PREFIX_PATH_SYSTEM=/system

# ============================================
# PostgreSQL 配置 / PostgreSQL Configuration
# ============================================
POSTGRESQL_HOST=172.18.0.6
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your-postgresql-password-here
POSTGRESQL_NAME_DEV=nfxnews_dev
POSTGRESQL_NAME_PROD=nfxnews
POSTGRESQL_NAME_SHADOW=nfxnews_diff
POSTGRES_SSLMODE=disable
ATLAS_POSTGRES_HOST=192.168.1.64
ATLAS_POSTGRES_PORT=10105
POSTGRES_CONTAINER_NAME=NFX-Stack-PostgreSQL

# ============================================
# Redis 配置 / Redis Configuration
# ============================================
REDIS_HOST=192.168.1.64
REDIS_PORT=10181
REDIS_PASSWORD=your-redis-password-here

# ============================================
# Kafka 配置 / Kafka Configuration
# ============================================
KAFKA_HOST=192.168.1.64
KAFKA_PORT=10183
KAFKA_BROKERS=192.168.1.64:10183

# ============================================
# OpenTelemetry / OTEL Configuration
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=192.168.1.64:10192

# ============================================
# Token 配置 / Token Configuration
# Must match NFX-Identity TOKEN_SECRET_KEY / TOKEN_ISSUER (user JWT local verify)
# ============================================
TOKEN_SECRET_KEY=your-secret-key-here-change-in-production
TOKEN_ISSUER=nfxidentity
TOKEN_ACCESS_TTL=24h
TOKEN_REFRESH_TTL=168h
TOKEN_ALGORITHM=HS256

# ============================================
# Email 配置 / Email Configuration
# ============================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-google-email-app-password-here
EMAIL_SMTP_FROM=your-email@gmail.com

# ============================================
# Notify webhooks (never commit real values)
# ============================================
NOTIFY_FEISHU_WEBHOOK_URL=
NOTIFY_DINGTALK_WEBHOOK_URL=
NOTIFY_WEWORK_WEBHOOK_URL=
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_NTFY_SERVER_URL=https://ntfy.sh
NOTIFY_NTFY_TOPIC=
NOTIFY_BARK_URL=
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_EMAIL_TO=
NOTIFY_PUSH_WINDOW_ENABLED=false
NOTIFY_PUSH_WINDOW_START=20:00
NOTIFY_PUSH_WINDOW_END=22:00
NOTIFY_PUSH_WINDOW_ONCE_PER_DAY=true
NOTIFY_BATCH_SEND_INTERVAL=3

CRAWL_SCHEDULE_SECONDS=30
CRAWL_INTERVAL_JITTER_PERCENT=15
FREQUENCY_WORDS_PATH=config/frequency_words.txt
